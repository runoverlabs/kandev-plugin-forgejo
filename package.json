{
  "name": "kandev-plugin-forgejo",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build:ui": "npm run typecheck && esbuild ui/src/bundle.ts --bundle --format=esm --target=es2022 --external:react --external:react-dom --outfile=ui/bundle.js",
    "lint": "npm run typecheck",
    "typecheck": "tsc --project ui/tsconfig.json --noEmit",
    "test": "npm run build:ui && vitest run"
  },
  "devDependencies": {
    "@kandev/plugin-sdk": "file:../kandev/apps/packages/plugin-sdk",
    "@types/node": "24.3.0",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
